3dfx16V2.DLL,,,2
3dfx32V2.DLL,,,2
GLIDE.DLL,,,2
GLIDE2X.DLL,GLIDE2X.MMX,,2
FXOEM2X.DLL,,,2
GLIDE3X.DLL,GLDEI3X.MMX,,2
