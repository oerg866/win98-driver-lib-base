RICHED20.DLL,,,2
CSH.DLL,,,2

[Voodoo2.CopyWin]
GLIDE2X.OVL,,,2
;VOODOO2.BMP,,,2

[Voodoo2.DelFiles]
FXMEMMAP.VXD,,,2
3dfxV2.DRV,,,2
3dfx16V2.DLL,,,2
3dfx32V2.DLL,,,2
GLIDE2X.DLL,,,2
