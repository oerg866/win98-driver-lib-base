;-----------------------------------------------------------------------
; INF file for Voodoo2 based 3D Accelerators running under Windows 95/98
; (c) 1998-1999 - 3dfx Interactive, Inc.
; 
; Installs Control Panel, DirectX, OpenGL, and Glide drivers
;-----------------------------------------------------------------------

[version]
Class=MEDIA
signature="$CHICAGO$"
Provider=%Mfg%

; Disk & Directory sections
;----------------------------------------
[DestinationDirs]
DefaultDestDir        = 11    ; LDID_SYS
Voodoo2.Copy          = 11
Voodoo2.CopyWin       = 10
Voodoo2.DelFiles      = 11
Voodoo2.DelWinFiles   = 10
Voodoo2.CopyRedist    = 11
Voodoo2Ini.DelFiles   = 10
WinHelp.Copy          = 18
WinHelp.DelFiles      = 18
Voodoo2Inf.Copy       = 17

[SourceDisksNames]
1="Voodoo2 Drivers for Windows 9X",,0

[SourceDisksFiles]
FXMEMMAP.VXD =1
3dfxV2.DRV   =1
3dfx16V2.DLL =1
3dfx32V2.DLL =1
MSVCRT.DLL   =1
GLIDE.DLL    =1
GLIDE2X.DLL  =1
GLIDE3X.DLL  =1
;GLIDE2X.MMX  =1
;GLIDE3X.MMX  =1
;GLIDE2X.3DN  =1
;GLIDE3X.3DN  =1
FXOEM2X.DLL  =1
GLIDE2X.OVL  =1
3dfxVGL.DLL  =1
RICHED20.DLL =1
3dfxV2PS.DLL =1
SST1INIT.DLL =1
3dfxV2PS.HLP =1
CSH.DLL      =1
;VOODOO2.BMP  =1
3dfxSpl2.dll =1
3dfxSpl3.dll =1

; Manufacturers
;----------------------------------------
[Manufacturer]
%Mfg%=Mfg

; Driver sections
;----------------------------------------
[Mfg]
%PCI\VEN_121A&DEV_0002.DeviceDesc%=Voodoo, PCI\VEN_121A&DEV_0002
; commented out so we only pick one during auto driver installs
;%PCI\VEN_121A&DEV_0002.DeviceDesc.MMX%=VoodooMMX, PCI\VEN_121A&DEV_0002
;%PCI\VEN_121A&DEV_0002.DeviceDesc.3DN%=Voodoo3DN, PCI\VEN_121A&DEV_0002

; Install sections
;----------------------------------------
[Voodoo]
DelFiles=Voodoo2.DelFiles,Voodoo2.DelWinFiles,WinHelp.DelFiles,Voodoo2Ini.DelFiles
CopyFiles=Voodoo2.Copy,Voodoo2.CopyWin,Voodoo2.CopyRedist,WinHelp.Copy,Voodoo2Inf.Copy
DelReg=Prev.DelReg
AddReg=Voodoo2.AddReg,Voodoo2.AddControl
Reboot
[VoodooMMX]
DelFiles=Voodoo2.DelFiles,Voodoo2.DelWinFiles,WinHelp.DelFiles,Voodoo2Ini.DelFiles
CopyFiles=Voodoo2MMX.Copy,Voodoo2.CopyWin,Voodoo2.CopyRedist,WinHelp.Copy,Voodoo2Inf.Copy
DelReg=Prev.DelReg
AddReg=Voodoo2.AddReg,Voodoo2.AddControl
Reboot
[Voodoo3DN]
DelFiles=Voodoo2.DelFiles,Voodoo2.DelWinFiles,WinHelp.DelFiles,Voodoo2Ini.DelFiles
CopyFiles=Voodoo23DN.Copy,Voodoo2.CopyWin,Voodoo2.CopyRedist,WinHelp.Copy,Voodoo2Inf.Copy
DelReg=Prev.DelReg
AddReg=Voodoo2.AddReg,Voodoo2.AddControl
Reboot

; Uninstall section
;----------------------------------------
[DefaultUninstall]
DelFiles=Voodoo2.Copy,Voodoo2.CopyWin,WinHelp.Copy,Voodoo2Inf.Copy
DelReg=Voodoo2.AddReg,Voodoo2.AddControl,Voodoo2.DelReg,Voodoo2.Enum
Reboot

[WinHelp.Copy]
3dfxV2PS.HLP,,,2

[Voodoo2Inf.Copy]
Voodoo2.Inf

[WinHelp.DelFiles]
3dfxV2PS.HLP,,,2

[Voodoo2Ini.DelFiles]
Voodoo2.Ini,,,2

[Voodoo2.Copy]
